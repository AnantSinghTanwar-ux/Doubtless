GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=text-embedding-004

NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Comma-separated emails allowed to review teacher applications at /admin/teachers
ADMIN_EMAILS=

# Optional TURN relay so video calls work on strict networks (e.g. a free key from metered.ca/stun-turn).
# Several URLs may be comma-separated. Calls work without it on most home/mobile networks.
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=

# Voice tutor (Vapi). The public key is meant for the browser; never put your private key here.
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
NEXT_PUBLIC_VAPI_ASSISTANT_ID=

# NVIDIA NIM (build.nvidia.com), an online AI provider that needs no local model. Server-side only: never prefix with NEXT_PUBLIC_.
# Set AI_PROVIDER=nvidia to make it the first choice; with any other provider it is used automatically if that one fails.
NVIDIA_API_KEY=
# Optional overrides (defaults shown):
# NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
# NVIDIA_FALLBACK_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# NVIDIA_VISION_MODEL=meta/llama-3.2-11b-vision-instruct

# Optional OpenAI-compatible gateway (e.g. cheaperinference.com). Used first, but ONLY on the deployed site (Vercel);
# on your own machine it stays off unless AI_GATEWAY_LOCAL=1. Any failure falls back to the other providers.
OPENAI_API_KEY=
OPENAI_BASE_URL=
# OPENAI_MODEL=gemini-2.5-flash
# OPENAI_VISION_MODEL=gemini-2.5-flash

# Local AI through Ollama. OLLAMA_BASE_URL may list several hosts, comma-separated; the first one that answers is used.
# Set OLLAMA_API_KEY when the host sits behind a bearer-token proxy.
# AI_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_API_KEY=
# OLLAMA_MODEL=llama3.2
# OLLAMA_EMBED_MODEL=nomic-embed-text
# Reads slides and formulas faithfully (run: ollama pull qwen2.5vl:3b). Falls back to llava if it is not installed.
# OLLAMA_VISION_MODEL=qwen2.5vl:3b
# OLLAMA_KEEP_ALIVE=30m
